<?xml version="1.0" encoding="utf-8"?>
<!-- Dokumen, foto halaman, dan tanda tangan hanya di HP ini: tidak ikut cadangan otomatis Google
     maupun pindah data antar-HP (sesuai janji "tidak dikirim ke mana pun"). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
